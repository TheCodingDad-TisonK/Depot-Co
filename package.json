{
  "name": "depot-co",
  "productName": "Depot Co",
  "version": "1.22.1",
  "description": "Standalone hobby game, NOT a Farming Simulator product. First-person warehouse simulator: receive trucks, put stock away, pick orders, pack them and ship them, then hire a crew and buy a forklift.",
  "main": "main.js",
  "author": "TheCodingDad-TisonK",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "serve": "node node_modules/co-engine/tools/serve.js",
    "build": "node node_modules/co-engine/tools/build-game.js && node node_modules/co-engine/tools/sync-version.js",
    "check": "node node_modules/co-engine/tools/build-game.js --check && node node_modules/co-engine/tools/sync-version.js && node node_modules/co-engine/tools/lint-gate.js game && node node_modules/co-engine/tools/check-syntax.js",
    "test": "node node_modules/co-engine/tools/build-game.js --check && node tools/devconsole/selftest.js && electron tools/smoke.js",
    "devconsole": "electron tools/devconsole/main.js",
    "devconsole:exe": "electron-builder --win portable --x64 --publish never --config tools/devconsole/builder.json",
    "dev": "electron . --dev-link",
    "brand": "electron tools/render-brand.js",
    "icon": "node tools/make-icon.js",
    "installer": "npm run check && npm run brand && npm run icon && node node_modules/co-engine/tools/verify-icon.js && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "co-engine": "github:TheCodingDad-TisonK/Co-Engine#v0.2.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.thecodingdad.depotco",
    "productName": "Depot Co",
    "copyright": "TheCodingDad-TisonK",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "co.json",
      "game/**/*",
      "package.json",
      "!node_modules/co-engine/{editor,template,docs,vendor,tests,engine,tools}/**",
      "!node_modules/co-engine/*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Depot Co",
      "runAfterFinish": true,
      "artifactName": "Depot-Co-Setup-${version}.exe"
    }
  }
}
